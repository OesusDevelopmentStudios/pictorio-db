  },
  "components": {
    "schemas": {
      "CreatedToken": {
        "properties": {
          "token_id": {
            "type": "integer",
            "title": "Token Id"
          },
          "token": {
            "type": "string",
            "title": "Token",
            "description": "Shown only in this response; the server keeps just its SHA-256"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          }
        },
        "type": "object",
        "required": [
          "token_id",
          "token",
          "user"
        ],
        "title": "CreatedToken"
      },
      "CurrentUser": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "restricted_tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Restricted Tags",
            "description": "Terms an admin has restricted for this user; [] if none"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "role",
          "restricted_tags"
        ],
        "title": "CurrentUser"
      },
      "DeviceToken": {
        "properties": {
          "token_id": {
            "type": "integer",
            "title": "Token Id"
          },
          "device_name": {
            "type": "string",
            "title": "Device Name"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "last_used_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Used At"
          },
          "is_current": {
            "type": "boolean",
            "title": "Is Current",
            "description": "The token this request was sent with"
          }
        },
        "type": "object",
        "required": [
          "token_id",
          "device_name",
          "created_at",
          "last_used_at",
          "is_current"
        ],
        "title": "DeviceToken"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "title": "Password"
          },
          "device_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Device Name",
            "examples": [
              "laptop (pictorio 0.1.0)"
            ]
          }
        },
        "type": "object",
        "required": [
          "username",
          "password",
          "device_name"
        ],
        "title": "LoginRequest"
      },
      "NewUser": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "title": "Password"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password",
          "role"
        ],
        "title": "NewUser"
      },
      "ProblemModel": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "ProblemModel",
        "description": "How a problem looks, for the API documentation. Some codes add fields of their own."
      },
      "Role": {
        "type": "string",
        "enum": [
          "admin",
          "user"
        ],
        "title": "Role"
      },
      "ServerInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "api_version": {
            "type": "integer",
            "title": "Api Version"
          },
          "setup_required": {
            "type": "boolean",
            "title": "Setup Required"
          }
        },
        "type": "object",
        "required": [
          "name",
          "version",
          "api_version",
          "setup_required"
        ],
        "title": "ServerInfo"
      },
      "UserChanges": {
        "properties": {
          "password": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ],
            "title": "Password",
            "description": "A new password also logs the user out on every device"
          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Role"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "UserChanges"
      },
      "UserDetails": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "restricted_tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Restricted Tags",
            "description": "Terms this user may not see or use; [] if none"
          },
          "restrictions_active": {
            "type": "boolean",
            "title": "Restrictions Active",
            "description": "False for admins: they are never restricted"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "role",
          "restricted_tags",
          "restrictions_active",
          "created_at"
        ],
        "title": "UserDetails"
      },
      "UserSummary": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "role"
        ],
        "title": "UserSummary"
      },
      "ValidationProblemModel": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "errors"
        ],
        "title": "ValidationProblemModel"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "An API token from POST /api/v1/auth/tokens",
        "scheme": "bearer"
      }
    }
  }
}
